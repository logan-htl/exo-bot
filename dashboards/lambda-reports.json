      "title": "Billed duration lớn nhất (ms)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, max by (service_name) (max_over_time({service_name=~\".+\"} | unwrap billed_duration_ms [${billed_window}])))",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
