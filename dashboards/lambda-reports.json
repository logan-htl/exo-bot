{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "title": "Lambda reports — top 10",
  "uid": "lambda-reports-top10",
  "tags": [
    "lambda",
    "g-bot"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Memory còn trống thấp nhất (%) — 1 ngày",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bottomk(10, min by (service_name) (min_over_time({service_name=~\".+\"} | unwrap memory_free_pct [1d])))",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "options": {
        "showHeader": true
      }
    },
    {
