          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "service_name",
        "showValue": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
