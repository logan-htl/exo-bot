{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "title": "Lambda reports — top 10",
  "uid": "lambda-reports-top10",
  "tags": [
    "lambda",
    "g-bot"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 4,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "mem_window",
        "label": "Khoảng thời gian: Memory còn trống thấp nhất (%)",
        "type": "custom",
        "query": "1d,7d,30d",
        "current": {
          "text": "1 ngày",
          "value": "1d"
        },
        "options": [
          {
            "selected": true,
            "text": "1 ngày",
            "value": "1d"
          },
          {
            "selected": false,
            "text": "1 tuần",
            "value": "7d"
          },
          {
            "selected": false,
            "text": "1 tháng",
            "value": "30d"
          }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0
      },
      {
        "name": "init_window",
        "label": "Khoảng thời gian: Init duration lớn nhất (ms)",
        "type": "custom",
        "query": "1d,7d,30d",
        "current": {
          "text": "1 ngày",
          "value": "1d"
        },
        "options": [
          {
            "selected": true,
            "text": "1 ngày",
            "value": "1d"
          },
          {
            "selected": false,
            "text": "1 tuần",
            "value": "7d"
          },
          {
            "selected": false,
            "text": "1 tháng",
            "value": "30d"
          }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0
      },
      {
        "name": "billed_window",
        "label": "Khoảng thời gian: Billed duration lớn nhất (ms)",
        "type": "custom",
        "query": "1d,7d,30d",
        "current": {
          "text": "1 ngày",
          "value": "1d"
        },
        "options": [
          {
            "selected": true,
            "text": "1 ngày",
            "value": "1d"
          },
          {
            "selected": false,
            "text": "1 tuần",
            "value": "7d"
          },
          {
            "selected": false,
            "text": "1 tháng",
            "value": "30d"
          }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "Memory còn trống thấp nhất (%)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bottomk(10, min by (service_name) (min_over_time({service_name=~\".+\"} | unwrap memory_free_pct [${mem_window}])))",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #A",
                "desc": false
              }
            ]
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "service_name",
        "showValue": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": 0,
        "stacking": "none"
      }
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Tổng memory cấu hình (MB), top 10",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, max by (service_name) (max_over_time({service_name=~\".+\"} | unwrap memory_size_mb [${mem_window}])))",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "service_name",
        "showValue": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xTickLabelRotation": 0,
        "stacking": "none"
      }
    },
    {
      "id": 3,
